# CDK
infra/cdk.out
# infra/cdk.context.json is committed (not ignored) — HostedZone.fromLookup
# needs it cached so `cdk synth` works in CI, which has no AWS credentials.
infra/dist
infra/*.js
infra/**/*.js
!infra/**/node_modules/**

